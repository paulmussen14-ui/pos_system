/* ===== Mejoras visuales del tema oscuro =====
   Esta capa se aplica DESPUÉS de dark.qss (ver ui/tema_iconos.py): lo que se
   repite aquí manda sobre dark.qss, y lo que no está aquí queda como estaba.
   Los marcadores de ícono (nombre entre dobles llaves) los reemplaza
   ui/tema_iconos.py por la ruta de cada ícono.
   Para quitar las mejoras basta con borrar este archivo. */

/* --- Botones: mismo alto en todos y borde que los hace parejos --- */
QPushButton {
    border: 1px solid transparent;
    min-height: 20px;
}

QPushButton.secondary {
    border: 1px solid #4b5563;
}

QPushButton.secondary:hover {
    border-color: #6b7280;
}

QPushButton:disabled {
    border-color: transparent;
}

QMessageBox QPushButton {
    min-width: 84px;
}

/* --- Campos de texto, listas desplegables y números --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    min-height: 20px;
    placeholder-text-color: #6b7280;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateEdit:hover, QTextEdit:hover {
    border: 1px solid #6b7280;
}

/* :focus va después de :hover para que el azul gane cuando están los dos */
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1px solid #10b981;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateEdit:disabled, QTextEdit:disabled {
    border: 1px solid #374151;
}

QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 28px;
    border: none;
}

QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url("{{ICONO_FLECHA_ABAJO}}");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    padding: 4px;
    border-radius: 6px;
}

/* El campo de texto que Qt mete dentro de los numéricos, fechas y listas
   editables no debe dibujar su propio borde ni relleno (si no, el texto queda
   pegado al borde y se ve un recuadro dentro de otro). */
QSpinBox QLineEdit, QDoubleSpinBox QLineEdit, QDateEdit QLineEdit, QComboBox QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-height: 0px;
}

/* Campos numéricos: los botones de subir/bajar con su flecha */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #374151;
    border-top-right-radius: 5px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    background-color: transparent;
    border: none;
    border-left: 1px solid #374151;
    border-bottom-right-radius: 5px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #374151;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("{{ICONO_FLECHA_ARRIBA}}");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("{{ICONO_FLECHA_ABAJO}}");
    width: 10px;
    height: 10px;
}

/* --- Checkboxes (cuadrados con palomita) y radios (redondos con punto) --- */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6b7280;
    background-color: #1f2937;
}

QCheckBox::indicator {
    border-radius: 5px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #10b981;
}

QCheckBox::indicator:checked {
    background-color: #059669;
    border: 1px solid #059669;
    image: url("{{ICONO_PALOMITA}}");
}

QRadioButton::indicator:checked {
    background-color: #059669;
    border: 1px solid #059669;
    image: url("{{ICONO_PUNTO}}");
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background-color: #10b981;
    border-color: #10b981;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background-color: #161e2c;
    border-color: #374151;
}

QCheckBox:disabled, QRadioButton:disabled {
    color: #6b7280;
}

/* --- Tablas --- */
QTableWidget, QTableView {
    outline: 0;
    gridline-color: #283548;
    alternate-background-color: #222d3e;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:hover, QTableView::item:hover {
    background-color: #263349;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: #0b3a2e;
    color: #ffffff;
}

/* La selección se sigue viendo aunque la tabla pierda el foco */
QTableWidget::item:selected:!active, QTableView::item:selected:!active {
    background-color: #0b3a2e;
    color: #ffffff;
}

/* El fondo del encabezado (también el hueco bajo los números de fila) */
QHeaderView {
    background-color: #111827;
    border: none;
}

QHeaderView::section {
    background-color: #111827;
    color: #9ca3af;
    padding: 10px 8px;
    border: none;
    border-bottom: 2px solid #059669;
    font-size: 12px;
    font-weight: 600;
}

QHeaderView::section:horizontal:first {
    border-top-left-radius: 7px;
}

QHeaderView::section:horizontal:last {
    border-top-right-radius: 7px;
}

QHeaderView::section:vertical {
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #283548;
    border-right: 1px solid #283548;
}

QTableCornerButton::section {
    background-color: #111827;
    border: none;
    border-bottom: 2px solid #059669;
}

/* --- Pestañas: la activa lleva una línea azul --- */
QTabBar::tab {
    padding: 9px 18px;
    margin-right: 2px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover:!selected {
    background-color: #1a2332;
    color: #e5e7eb;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #10b981;
}

/* --- Menú lateral: botones en forma de píldora --- */
QWidget#sidebar QPushButton {
    margin: 2px 12px;
    padding: 10px 14px;
    border-radius: 8px;
}

/* --- Barras de desplazamiento --- */
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #6b7280;
}

QScrollBar::handle:vertical:pressed, QScrollBar::handle:horizontal:pressed {
    background: #9ca3af;
}

/* --- Etiquetas de estado en forma de píldora --- */
QLabel.badgeOk, QLabel.badgeWarning, QLabel.badgeDanger {
    border-radius: 9px;
    padding: 2px 10px;
}

/* --- Calendario que se abre desde los campos de fecha --- */
QCalendarWidget QWidget {
    background-color: #1f2937;
    alternate-background-color: #1f2937;
    color: #e5e7eb;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #e5e7eb;
    border-radius: 6px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #374151;
}

QCalendarWidget QAbstractItemView:enabled {
    selection-background-color: #059669;
    selection-color: #ffffff;
    outline: 0;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #6b7280;
}

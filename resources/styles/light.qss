/* ===== Tema claro ===== */

* {
    font-family: "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1f2430;
}

QMainWindow, QWidget#centralWidget {
    background-color: #f4f6f9;
}

/* --- Diálogos y mensajes emergentes --- */
QDialog {
    background-color: #f4f6f9;
}

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #1f2430;
}

QToolTip {
    background-color: #1f2937;
    color: #f9fafb;
    border: 1px solid #374151;
    padding: 4px 8px;
    border-radius: 4px;
}

/* --- Áreas con scroll (ej. Inicio/Dashboard) ---
   Por consistencia con el tema oscuro; en claro es menos crítico,
   pero evita fondos inconsistentes en el viewport interno. */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* --- Sidebar --- */
QWidget#sidebar {
    background-color: #1f2937;
    min-width: 220px;
    max-width: 220px;
}

QWidget#sidebar QPushButton {
    background-color: transparent;
    color: #d1d5db;
    text-align: left;
    padding: 12px 18px;
    border: none;
    font-size: 14px;
    border-radius: 0px;
}

QWidget#sidebar QPushButton:hover {
    background-color: #374151;
    color: #ffffff;
}

QWidget#sidebar QPushButton:checked {
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QLabel#sidebarTitle {
    color: #ffffff;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0px;
}

QWidget#sidebarHeader {
    border-bottom: 1px solid #e5e7eb;
}

QFrame#logoCard {
    background-color: #ffffff;
    border-radius: 18px;
    border: 1px solid #e5e7eb;
}

/* --- Cards --- */
QFrame.card {
    background-color: #ffffff;
    border-radius: 10px;
    border: 1px solid #e5e7eb;
    padding: 16px;
}

QLabel.cardTitle {
    color: #6b7280;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

QLabel.cardValue {
    color: #111827;
    font-size: 26px;
    font-weight: 700;
}

/* --- Botones --- */
QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #9ca3af;
    color: #f3f4f6;
}

QPushButton.secondary {
    background-color: #e5e7eb;
    color: #1f2430;
}

QPushButton.secondary:hover {
    background-color: #d1d5db;
}

QPushButton.danger {
    background-color: #dc2626;
}

QPushButton.danger:hover {
    background-color: #b91c1c;
}

QPushButton.success {
    background-color: #16a34a;
}

QPushButton.success:hover {
    background-color: #15803d;
}

/* --- Inputs --- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #2563eb;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QTextEdit:focus, QDateEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QTextEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

QLineEdit::placeholder {
    color: #9ca3af;
}

/* Flecha y botones internos de spin/combo */
QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2430;
    border: 1px solid #d1d5db;
    selection-background-color: #dbeafe;
    selection-color: #1f2430;
    outline: none;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: #f3f4f6;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #e5e7eb;
}

/* --- Listas (búsqueda de productos, clientes, backups, etc.) --- */
QListWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    color: #1f2430;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:hover {
    background-color: #f3f4f6;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1f2430;
}

/* --- Checkboxes y radios --- */
QCheckBox, QRadioButton {
    color: #1f2430;
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #d1d5db;
    border-radius: 3px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #2563eb;
    border: 1px solid #2563eb;
}

/* --- Tablas --- */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    gridline-color: #f3f4f6;
    selection-background-color: #dbeafe;
    selection-color: #1f2430;
}

QHeaderView::section {
    background-color: #f9fafb;
    color: #374151;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #e5e7eb;
    font-weight: 600;
}

QTableWidget::item, QTableView::item {
    padding: 6px;
}

QTableCornerButton::section {
    background-color: #f9fafb;
    border: none;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #f4f6f9;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    font-weight: 600;
    color: #2563eb;
}

/* --- Splitters (Ventas: columnas productos/cliente/carrito) --- */
QSplitter::handle {
    background-color: #e5e7eb;
}

QSplitter::handle:hover {
    background-color: #d1d5db;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QLabel#sidebarUser { color: #64748b; font-size: 12px; }

/* --- Badges de estado --- */
QLabel.badgeOk {
    background-color: #dcfce7;
    color: #166534;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

QLabel.badgeWarning {
    background-color: #fef3c7;
    color: #92400e;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}

QLabel.badgeDanger {
    background-color: #fee2e2;
    color: #991b1b;
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: 600;
}